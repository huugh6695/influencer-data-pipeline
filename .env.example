# 复制为 .env 后填写。.env 不要提交到仓库，本文件只列键名、不含任何真实凭证。
# 注意：02 与 04 共用下面几个 LLM_* 键名，但默认服务不同，分别运行时按需设置。

# --- 02_微信AI助手 ---
HOST=0.0.0.0
PORT=8100
DB_PATH=data/agent.db
ADMIN_TOKEN=
CHANNEL=mock
OUTBOUND_WEBHOOK_URL=
OUTBOUND_TIMEOUT=15
ALLOWLIST=
QUIET_HOURS=
RATE_LIMIT_PER_MIN=6
MEMORY_WINDOW=20
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8:latest
LLM_TIMEOUT=120
PERSONA_NAME=小鱼
PERSONA_PROMPT=

# --- 04_API接入 ---
# 运行 llm_client.py 时，把 LLM_BASE_URL 改成对应的兼容接口地址。
VISION_MODEL=qwen-vl-max
FEISHU_APP_ID=
FEISHU_APP_SECRET=
